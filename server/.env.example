# Copy to server/.env for local runs, or pass these to the container.

# Where DevTime is reachable (OIDC redirect, badge and profile links, emails).
PUBLIC_URL=https://dev.bayfield.dev
PORT=8790

# PostgreSQL. Docker Compose sets this for you; for local development without Docker,
# `npm run db:dev` starts a local Postgres on this address.
DATABASE_URL=postgres://postgres:devtime@127.0.0.1:5433/postgres
# DATABASE_POOL_MAX=10

# --- Sign in with Authentik (any OIDC provider works): the only way in, required ---
# Authentik: Applications → Providers → OAuth2/OpenID, confidential client,
# redirect URI ${PUBLIC_URL}/api/auth/oidc/callback, scopes openid profile email.
# The issuer is the provider's "OpenID Configuration Issuer", e.g. https://auth.example.com/application/o/devtime/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# Create accounts on first sign-in (default true). Set false to only let in users an admin created.
# OIDC_AUTO_CREATE=true
# Comma-separated Authentik groups allowed in (empty: anyone the provider lets through).
# OIDC_ALLOWED_GROUPS=
# Members of these groups are DevTime admins.
# OIDC_ADMIN_GROUPS=

# Local development without Authentik: sign straight in as this user (created if missing).
# Only honoured when PUBLIC_URL is http://localhost; leave unset everywhere else.
# DEV_LOGIN_USER=demo
# Idle days before a session expires.
# SESSION_IDLE_DAYS=30

# --- Weekly report emails (off when unset) ---
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=DevTime <devtime@example.com>

# Header your reverse proxy puts the visitor IP in, used for rate limiting
# (behind a Cloudflare Tunnel: cf-connecting-ip). Leave unset if the port is reachable without the proxy.
# CLIENT_IP_HEADER=cf-connecting-ip

# Heartbeats older than this are rejected (wakatime-cli's offline queue can replay old ones).
# HEARTBEAT_MAX_AGE_DAYS=365

# Look on GitHub for a newer release, shown in Settings → About (cached for 6 hours).
# Set false if the server shouldn't make outbound requests.
# UPDATE_CHECK=true
